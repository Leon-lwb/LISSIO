{
  "name": "lissio",
  "private": true,
  "version": "0.9.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Umbrella repository: orchestrates the server and client repositories without owning their code",
  "scripts": {
    "dev": "pnpm --dir client dev",
    "dev:web": "pnpm dev",
    "dev:server": "node scripts/local-env.mjs cargo run --manifest-path server/Cargo.toml -p lissio-backend-server --",
    "dev:desktop": "node scripts/local-env.mjs desktop \"pnpm prepare:sidecar && pnpm --dir client exec tauri dev\"",
    "server": "pnpm dev:server",
    "prepare:sidecar": "node scripts/local-env.mjs node scripts/prepare-sidecar.mjs",
    "prepare:sidecar:release": "node scripts/local-env.mjs node scripts/prepare-sidecar.mjs --release",
    "build:desktop": "pnpm --dir client build:desktop",
    "build:web": "pnpm --dir client build:web",
    "build:server": "node scripts/local-env.mjs cargo build --manifest-path server/Cargo.toml --release -p lissio-backend-server -p lissio-backend-cli",
    "build:cli": "node scripts/local-env.mjs cargo build --manifest-path server/Cargo.toml --release -p lissio-backend-cli",
    "build:all": "pnpm build:server && pnpm build:desktop && node scripts/local-env.mjs node scripts/finalize-bundles.mjs",
    "build": "pnpm build:web",
    "preview": "pnpm --dir client preview",
    "test": "vitest run",
    "test:client": "pnpm --dir client test",
    "test:e2e": "node scripts/local-env.mjs playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm --dir client typecheck",
    "lint": "pnpm --dir client lint",
    "lint:fix": "pnpm --dir client lint:fix",
    "lint:ci": "pnpm --dir client lint:ci",
    "architecture": "node scripts/architecture.mjs",
    "check:architecture": "node scripts/check-crate-architecture.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:tauri-versions": "node scripts/check-tauri-versions.mjs",
    "check:web-contract": "node scripts/check-web-contract.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:device-contracts": "node scripts/check-device-contracts.mjs",
    "check:model-catalog": "node scripts/check-model-catalog.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tokens": "node scripts/check-ui-tokens.mjs",
    "check:motion": "node scripts/check-motion-css.mjs",
    "check:layers": "node scripts/check-ui-layers.mjs",
    "check:rust-size": "node scripts/check-crate-size.mjs",
    "check:ci-gates": "node scripts/check-ci-gates.mjs",
    "check:changes": "node scripts/check-changes.mjs",
    "check:release-sync": "node scripts/check-release-sync.mjs",
    "changes:add": "covector add",
    "changes:status": "covector status",
    "release:prepare": "node scripts/release-prepare.mjs",
    "gates": "node scripts/gates.mjs",
    "docs:motion": "node scripts/gen-motion-docs.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:all:quick": "node scripts/check-all.mjs --quick",
    "publish:crates": "node scripts/publish-crates.mjs",
    "bench:audit": "bash scripts/bench-audit.sh quick",
    "bench:full": "bash scripts/bench-audit.sh full",
    "bench:collect": "node scripts/bench-collect.mjs",
    "bench:check": "node scripts/bench-collect.mjs --check docs/experiments/results/criterion.json",
    "test:perf": "node scripts/local-env.mjs playwright test --config=playwright.perf.config.ts",
    "perf:collect": "node scripts/local-env.mjs node scripts/perf-collect.mjs",
    "perf:check": "node scripts/local-env.mjs node scripts/perf-collect.mjs --check",
    "perf:baseline": "node scripts/local-env.mjs node scripts/perf-collect.mjs --update-baseline",
    "set-version": "node scripts/set-version.mjs",
    "auto-build": "bash scripts/auto-build.sh",
    "tauri": "pnpm --dir client tauri",
    "publish:release": "node scripts/publish-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "covector": "0.13.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/lissio-industries/Lissio.git"
  },
  "homepage": "https://lissio.pengheng.top",
  "bugs": "https://codeberg.org/lissio-industries/Lissio/issues"
}
