{
  "name": "lissio",
  "private": true,
  "version": "0.7.2",
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "cargo run --manifest-path src-tauri/Cargo.toml -p lissio-backend-server --",
    "dev:desktop": "pnpm prepare:sidecar && tauri dev",
    "server": "pnpm dev:server",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:sidecar:release": "node scripts/prepare-sidecar.mjs --release",
    "build:desktop": "pnpm prepare:sidecar:release && tauri build --config src-tauri/tauri.local.conf.json",
    "build:web": "tsc && vite build",
    "build:server": "cargo build --manifest-path src-tauri/Cargo.toml --release -p lissio-backend-server -p lissio-backend-cli",
    "build:cli": "cargo build --manifest-path src-tauri/Cargo.toml --release -p lissio-backend-cli",
    "build:all": "pnpm build:server && pnpm build:desktop",
    "build": "pnpm build:web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "architecture": "node scripts/architecture.mjs",
    "check:architecture": "node scripts/check-crate-architecture.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:web-contract": "node scripts/check-web-contract.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:model-catalog": "node scripts/check-model-catalog.mjs",
    "check:tokens": "node scripts/check-ui-tokens.mjs",
    "publish:crates": "node scripts/publish-crates.mjs",
    "bench:audit": "bash scripts/bench-audit.sh quick",
    "bench:full": "bash scripts/bench-audit.sh full",
    "bench:collect": "node scripts/bench-collect.mjs",
    "bench:check": "node scripts/bench-collect.mjs --check docs/experiments/results/criterion.json",
    "set-version": "node scripts/set-version.mjs",
    "auto-build": "bash scripts/auto-build.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/x": "2.5.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.4",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "uplot": "^1.6.32",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
